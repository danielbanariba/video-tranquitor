# ============================================================================
# video-tranquitor — plantilla de configuración
# Copiala a .env y completá lo tuyo. El .env real nunca se commitea.
# ============================================================================

# --- Transcripción ---------------------------------------------------------
# local | openai | whisperx | ensemble
# whisperx es la recomendada. El modo ensemble corre whisper.cpp y WhisperX en
# paralelo y arbitra con un LLM, pero se midió: el árbitro reproduce a WhisperX
# en todos los chunks y donde se desvía rompe los nombres técnicos.
TRANSCRIBER=whisperx
WHISPERX_MODEL=large-v3

# Requeridas solo para TRANSCRIBER=local o ensemble
WHISPER_CPP_PATH=/ruta/a/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=/ruta/a/ggml-large-v3-turbo.bin

# 5 es el default de WhisperX. Subirlo NO mejoró en las pruebas: con 10 el
# modelo perdió por completo un nombre propio que con 5 sí captaba.
# WHISPERX_BEAM_SIZE=5

# --- Diarización de hablantes ----------------------------------------------
# Aceptá las condiciones en
# https://huggingface.co/pyannote/speaker-diarization-community-1
# y generá un token de tipo Read en https://huggingface.co/settings/tokens
ENABLE_DIARIZATION=true
HF_TOKEN=hf_tu_token_aca
# DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# DIARIZATION_EXCLUSIVE=true

# --- Análisis con IA -------------------------------------------------------
ENABLE_ANALYSIS=true
# codex (usa el CLI de Codex) | claude (usa el CLI de Claude Code)
ANALYSIS_PROVIDER=claude
# Modelo del proveedor elegido. Vacío = su default.
#   codex:  gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna
#   claude: opus, sonnet, fable
ANALYSIS_MODEL=opus
# codex acepta minimal|low|medium|high|xhigh — claude acepta low|medium|high|xhigh|max
ANALYSIS_EFFORT=max
# Pasadas del análisis que después se unen. El modelo no es determinista: con 1
# sola pasada se midió que pierde datos concretos que otra corrida sí captura.
ANALYSIS_PASSES=3

# --- Salidas ---------------------------------------------------------------
ENABLE_TOON=true
ENABLE_OBSIDIAN=true
OBSIDIAN_VAULT_PATH=/ruta/a/tu/vault

# --- Directorios y audio ---------------------------------------------------
WATCH_DIR=./Audios
OUTPUT_DIR=./output
AUDIO_LANGUAGE=es
TARGET_SAMPLE_RATE=16000

# Sin loudnorm a propósito: costaba 102 de los 112 segundos del preprocess y no
# aportaba calidad, porque Whisper ya normaliza al calcular el log-mel.
# AUDIO_FILTER=highpass=f=80, lowpass=f=12000, afftdn=nf=-25

# --- Solo para TRANSCRIBER=openai ------------------------------------------
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
