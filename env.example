# ============================================================
# video-tranquitor — variables de entorno
# Copiá este archivo a .env y completá los valores requeridos
# ============================================================

# Directorio donde se monitorean nuevos archivos de audio/video
# Default: ./Audios
WATCH_DIR=./Audios

# Directorio donde se guardan los archivos de salida
# Default: ./output
OUTPUT_DIR=./output

# Motor de transcripción: "local" (whisper.cpp) o "openai" (Whisper API)
# Default: local
TRANSCRIBER=local

# --- Requerido cuando TRANSCRIBER=local ---

# Ruta al ejecutable de whisper.cpp
# Ejemplo: /home/banar/whisper.cpp/main
WHISPER_CPP_PATH=

# Ruta al modelo de whisper (archivo .bin)
# Ejemplo: /home/banar/whisper.cpp/models/ggml-large-v3.bin
WHISPER_MODEL_PATH=

# --- OpenAI ---

# API Key de OpenAI (REQUERIDA — usada para análisis y/o transcripción openai)
OPENAI_API_KEY=

# Modelo de transcripción de OpenAI
# Default: gpt-4o-transcribe
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# --- Features opcionales ---

# Activar diarización (identificación de hablantes)
# Default: false — requiere HF_TOKEN cuando es true
ENABLE_DIARIZATION=false

# Token de Hugging Face (requerido cuando ENABLE_DIARIZATION=true)
HF_TOKEN=

# Activar análisis semántico del contenido con IA
# Default: true
ENABLE_ANALYSIS=true

# Activar escritura en Obsidian
# Default: true
ENABLE_OBSIDIAN=true

# Activar salida en formato TOON
# Default: true
ENABLE_TOON=true

# Ruta al vault de Obsidian donde se guardan las notas
# Default: /home/banar/Desktop/obsidian/Farinter/07-Reuniones
OBSIDIAN_VAULT_PATH=/home/banar/Desktop/obsidian/Farinter/07-Reuniones

# --- Audio ---

# Filtros de FFmpeg aplicados al audio antes de transcribir
# Default: highpass=f=80, lowpass=f=12000, afftdn=nf=-25, loudnorm=I=-16:TP=-1.5:LRA=11
AUDIO_FILTER=highpass=f=80, lowpass=f=12000, afftdn=nf=-25, loudnorm=I=-16:TP=-1.5:LRA=11

# Sample rate objetivo del audio preprocesado
# Default: 16000
TARGET_SAMPLE_RATE=16000

# --- Transcripción ---

# Idioma del audio
# Default: es
LANGUAGE=es

# Prompt de contexto para guiar la transcripción
# Default: texto en español
TRANSCRIPTION_PROMPT=Transcribe en espanol con puntuacion clara. Mantiene nombres propios, numeros y siglas tal como se escuchan.
